# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NGHIÊM CẤM COMMIT DƯỚI MỌI HÌNH THỨC)
.env
.env*.local
.env.local
.env.development
.env.test
.env.production
.env*
!.env.example

# File ảnh tải lên lúc runtime (không commit ảnh test)
public/uploads/*
!public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
