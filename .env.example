# Database connection string (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Secret cho xác thực admin (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET="your_jwt_secret_key_at_least_32_characters_here"

# Domain công khai của trang web (dùng cho metadata, OpenGraph, upload URL)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Môi trường chạy ứng dụng
NODE_ENV="development"
